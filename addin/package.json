{
  "name": "outlook-mail-adviser-addin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "test:watch": "vitest --config vitest.config.ts --configLoader runner",
    "certs": "node scripts/export-dev-cert.mjs",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:dev": "office-addin-manifest validate manifest.dev.xml",
    "validate:local-host": "office-addin-manifest validate manifest.localhost.xml",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.609",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fs-extra": "^11.4.1",
    "jsdom": "^26.1.0",
    "office-addin-manifest": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
